# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Force standalone mode via environment variable
ENV NEXT_PRIVATE_STANDALONE=true
RUN npm run build

# Stage 2: Runner
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy the standalone files (Next.js creates these in .next/standalone)
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# Only copy public if the folder exists
COPY --from=builder /app/public* ./public 

EXPOSE 3000

# Standalone mode builds a server.js file automatically
CMD ["node", "server.js"]
